{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "MiniMax": {
      "type": "local",
      "command": [
        "uvx",
        "minimax-coding-plan-mcp",
        "-y"
      ],
      "environment": {
        "MINIMAX_API_KEY": "토큰",
        "MINIMAX_API_HOST": "https://api.minimax.io"
      },
      "enabled": true
    }
  },
  "provider": {
    "nvidia": {
      "base_url": "https://integrate.api.nvidia.com/v1"
    }
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "oh-my-openagent"
  ]
}
